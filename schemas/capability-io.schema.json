{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/video-editing-toolkit/capability-io.schema.json",
  "title": "Video Editing Toolkit Capability I/O Draft",
  "type": "object",
  "$defs": {
    "toolkit_run_input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "toolkit_id",
        "capability",
        "version",
        "input",
        "context"
      ],
      "properties": {
        "toolkit_id": {
          "const": "video-editing-toolkit"
        },
        "capability": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "input": {
          "type": "object"
        },
        "context": {
          "$ref": "#/$defs/run_context"
        }
      }
    },
    "toolkit_run_output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "toolkit_id",
        "capability",
        "version",
        "trace_id",
        "usage_metrics",
        "artifact_refs"
      ],
      "properties": {
        "toolkit_id": {
          "const": "video-editing-toolkit"
        },
        "capability": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "trace_id": {
          "type": "string"
        },
        "usage_metrics": {
          "$ref": "#/$defs/usage_metrics"
        },
        "artifact_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/artifact_ref"
          }
        },
        "error_code": {
          "type": "string"
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "media_artifact_input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_ref"
      ],
      "properties": {
        "artifact_ref": {
          "$ref": "#/$defs/artifact_ref"
        },
        "options": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "artifact_collection_input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_refs"
      ],
      "properties": {
        "artifact_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/artifact_ref"
          }
        },
        "options": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "project_input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_id"
      ],
      "properties": {
        "project_id": {
          "type": "string",
          "minLength": 1
        },
        "version_id": {
          "type": "string"
        },
        "options": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "project_version_compare_input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_id",
        "left_version_id",
        "right_version_id"
      ],
      "properties": {
        "project_id": {
          "type": "string",
          "minLength": 1
        },
        "left_version_id": {
          "type": "string",
          "minLength": 1
        },
        "right_version_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "timeline_patch_input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_id",
        "base_version_id",
        "timeline_patch",
        "change_reason",
        "requested_preview"
      ],
      "properties": {
        "project_id": {
          "type": "string",
          "minLength": 1
        },
        "base_version_id": {
          "type": "string",
          "minLength": 1
        },
        "timeline_patch": {
          "$ref": "#/$defs/timeline_patch"
        },
        "change_reason": {
          "type": "string",
          "minLength": 1
        },
        "requested_preview": {
          "type": "boolean"
        }
      }
    },
    "timeline_patch_output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_id",
        "new_version_id",
        "timeline_summary",
        "warnings",
        "artifact_refs"
      ],
      "properties": {
        "project_id": {
          "type": "string"
        },
        "new_version_id": {
          "type": "string"
        },
        "timeline_summary": {
          "type": "object",
          "additionalProperties": true
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "preview_artifact_ref": {
          "$ref": "#/$defs/artifact_ref"
        },
        "artifact_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/artifact_ref"
          }
        }
      }
    },
    "probe_media_output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metadata",
        "warnings"
      ],
      "properties": {
        "metadata": {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "duration_seconds",
            "streams"
          ],
          "properties": {
            "duration_seconds": {
              "type": "number",
              "minimum": 0
            },
            "streams": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": true
              }
            }
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "artifact_output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_refs",
        "warnings"
      ],
      "properties": {
        "artifact_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/artifact_ref"
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "project_output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_id",
        "version_id",
        "artifact_refs",
        "warnings"
      ],
      "properties": {
        "project_id": {
          "type": "string"
        },
        "version_id": {
          "type": "string"
        },
        "artifact_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/artifact_ref"
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "timeline_patch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operations"
      ],
      "properties": {
        "operations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/timeline_operation"
          }
        }
      }
    },
    "timeline_operation": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "op"
      ],
      "properties": {
        "op": {
          "type": "string",
          "enum": [
            "add_clip",
            "remove_clip",
            "split_clip",
            "move_clip",
            "set_in_out",
            "add_text",
            "add_audio",
            "set_transition",
            "set_effect"
          ]
        }
      }
    },
    "artifact_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "artifact_type",
        "owner_tenant_id",
        "created_by_run_id",
        "mime_type",
        "size_bytes",
        "checksum",
        "data_class",
        "retention_policy",
        "access_policy"
      ],
      "properties": {
        "artifact_id": {
          "type": "string",
          "minLength": 1
        },
        "artifact_type": {
          "type": "string",
          "minLength": 1
        },
        "owner_tenant_id": {
          "type": "string",
          "minLength": 1
        },
        "created_by_run_id": {
          "type": "string",
          "minLength": 1
        },
        "storage_uri": {
          "type": "string",
          "description": "Internal only. Do not expose to agents or upstream callers."
        },
        "mime_type": {
          "type": "string"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "checksum": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "algorithm",
            "value"
          ],
          "properties": {
            "algorithm": {
              "type": "string",
              "enum": [
                "sha256"
              ]
            },
            "value": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "data_class": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high",
            "restricted"
          ]
        },
        "retention_policy": {
          "type": "string"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "access_policy": {
          "type": "string"
        }
      }
    },
    "public_artifact_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "artifact_type"
      ],
      "properties": {
        "artifact_id": {
          "type": "string",
          "minLength": 1
        },
        "artifact_type": {
          "type": "string",
          "minLength": 1
        },
        "mime_type": {
          "type": "string"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "checksum": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "object",
              "additionalProperties": true
            }
          ]
        },
        "data_class": {
          "type": "string"
        },
        "retention_policy": {
          "type": "string"
        },
        "expires_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "download_url": {
          "type": "string"
        },
        "access_policy": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "object",
              "additionalProperties": true
            }
          ]
        }
      }
    },
    "run_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tenant_id",
        "run_id",
        "tool_call_id"
      ],
      "properties": {
        "tenant_id": {
          "type": "string",
          "minLength": 1
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "tool_call_id": {
          "type": "string",
          "minLength": 1
        },
        "approval_context": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "usage_metrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "input_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "output_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "media_duration_seconds": {
          "type": "number",
          "minimum": 0
        },
        "frame_count": {
          "type": "integer",
          "minimum": 0
        },
        "render_seconds": {
          "type": "number",
          "minimum": 0
        },
        "transcript_minutes": {
          "type": "number",
          "minimum": 0
        },
        "worker_cpu_seconds": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "voiceover_input": {
      "type": "object",
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "text"
          ]
        },
        {
          "required": [
            "script"
          ]
        },
        {
          "required": [
            "segments"
          ]
        },
        {
          "required": [
            "script_artifact_ref"
          ]
        },
        {
          "required": [
            "preflight_only"
          ]
        },
        {
          "required": [
            "synthesis_mode"
          ]
        }
      ],
      "properties": {
        "project_id": {
          "type": "string",
          "minLength": 1
        },
        "script_artifact_ref": {
          "$ref": "#/$defs/public_artifact_ref"
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "script": {
          "type": "string",
          "minLength": 1
        },
        "segments": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "object",
                "additionalProperties": true,
                "required": [
                  "text"
                ],
                "properties": {
                  "text": {
                    "type": "string",
                    "minLength": 1
                  },
                  "start_seconds": {
                    "type": "number"
                  },
                  "end_seconds": {
                    "type": "number"
                  },
                  "duration_seconds": {
                    "type": "number",
                    "minimum": 0
                  }
                }
              }
            ]
          }
        },
        "voice_profile": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "system_voice",
                "licensed_synthetic"
              ]
            },
            "voice_id": {
              "type": "string",
              "minLength": 1
            },
            "locale": {
              "type": "string",
              "minLength": 2
            },
            "style": {
              "type": "string"
            },
            "speed": {
              "type": "number",
              "minimum": 0.5,
              "maximum": 2.0
            }
          }
        },
        "voice": {
          "type": "object",
          "additionalProperties": true
        },
        "voice_preset": {
          "type": "string"
        },
        "language": {
          "type": "string"
        },
        "style": {
          "type": "string"
        },
        "pace": {
          "type": "string"
        },
        "pitch": {
          "type": "string"
        },
        "synthesis_mode": {
          "type": "string",
          "enum": [
            "plan_only",
            "preflight_only"
          ]
        },
        "mode": {
          "type": "string"
        },
        "dry_run": {
          "type": "boolean"
        },
        "preflight_only": {
          "type": "boolean"
        },
        "model_root": {
          "type": "string"
        },
        "model_bundle_root": {
          "type": "string"
        },
        "moss_tts_nano_model_root": {
          "type": "string"
        },
        "tts_bundle": {
          "type": "string"
        },
        "tts_bundle_path": {
          "type": "string"
        },
        "moss_tts_nano_tts_bundle": {
          "type": "string"
        },
        "codec_bundle": {
          "type": "string"
        },
        "codec_bundle_path": {
          "type": "string"
        },
        "moss_tts_nano_codec_bundle": {
          "type": "string"
        },
        "sample_rate_hz": {
          "type": "integer",
          "minimum": 8000,
          "maximum": 96000
        },
        "output_format": {
          "oneOf": [
            {
              "type": "string",
              "enum": [
                "wav",
                "mp3",
                "m4a",
                "flac",
                "ogg"
              ]
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "container",
                "audio_codec"
              ],
              "properties": {
                "container": {
                  "type": "string",
                  "enum": [
                    "wav",
                    "mp3",
                    "m4a",
                    "flac",
                    "ogg"
                  ]
                },
                "audio_codec": {
                  "type": "string"
                },
                "sample_rate_hz": {
                  "type": "integer",
                  "minimum": 8000,
                  "maximum": 96000
                }
              }
            }
          ]
        },
        "format": {
          "type": "string"
        },
        "emit_manifest_artifact": {
          "type": "boolean"
        },
        "consent_policy": {
          "type": "object",
          "additionalProperties": true
        },
        "approval_context": {
          "type": "object",
          "additionalProperties": true
        },
        "options": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "voiceover_output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "operation",
        "model_runtime"
      ],
      "properties": {
        "schema": {
          "type": "string"
        },
        "operation": {
          "const": "generate_voiceover"
        },
        "reason_code": {
          "type": "string"
        },
        "synthesis_mode": {
          "type": "string"
        },
        "plan_available": {
          "type": "boolean"
        },
        "voiceover_plan": {
          "type": "object",
          "additionalProperties": true
        },
        "voiceover_manifest": {
          "type": "object",
          "additionalProperties": true
        },
        "runtime_preflight": {
          "$ref": "#/$defs/tts_runtime_preflight"
        },
        "model_runtime": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "provider",
            "backend",
            "model_configured",
            "downloads_disabled_by_default",
            "network_access",
            "execution_enabled",
            "reason_code"
          ],
          "properties": {
            "provider": {
              "const": "MOSS-TTS-Nano"
            },
            "backend": {
              "const": "onnx_cpu"
            },
            "model_configured": {
              "type": "boolean"
            },
            "downloads_disabled_by_default": {
              "const": true
            },
            "network_access": {
              "const": "disabled_by_contract"
            },
            "execution_enabled": {
              "const": false
            },
            "reason_code": {
              "type": "string"
            }
          }
        },
        "audio_artifact_ref": {
          "oneOf": [
            {
              "$ref": "#/$defs/public_artifact_ref"
            },
            {
              "type": "null"
            }
          ]
        },
        "voiceover_manifest_artifact_ref": {
          "$ref": "#/$defs/public_artifact_ref"
        },
        "artifact_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/public_artifact_ref"
          }
        },
        "requires_consent": {
          "type": "boolean"
        },
        "deferred_capability": {
          "type": "string"
        },
        "required_context": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "qc_report_input": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "project_id": {
          "type": "string",
          "minLength": 1
        },
        "artifact_ref": {
          "$ref": "#/$defs/public_artifact_ref"
        },
        "media_probe": {
          "type": "object",
          "additionalProperties": true
        },
        "probe": {
          "type": "object",
          "additionalProperties": true
        },
        "timeline": {
          "type": "object",
          "additionalProperties": true
        },
        "composition_plan": {
          "type": "object",
          "additionalProperties": true
        },
        "subtitles": {
          "oneOf": [
            {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": true
              }
            },
            {
              "type": "object",
              "additionalProperties": true
            }
          ]
        },
        "subtitle_segments": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "audio_quality": {
          "type": "object",
          "additionalProperties": true
        },
        "visual_quality": {
          "type": "object",
          "additionalProperties": true
        },
        "brand_kit": {
          "type": "object",
          "additionalProperties": true
        },
        "delivery_targets": {
          "type": "object",
          "additionalProperties": true
        },
        "platform_profile": {
          "type": "object",
          "additionalProperties": true
        },
        "text_corpus": {
          "type": "string"
        },
        "drift_warning_threshold_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "options": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "qc_report_output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "qc_report"
      ],
      "properties": {
        "qc_report": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema",
            "summary",
            "severity_counts",
            "checks",
            "blocking_issues",
            "warnings",
            "evidence_refs"
          ],
          "properties": {
            "schema": {
              "type": "string"
            },
            "summary": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "status",
                "check_count",
                "pass_count",
                "warning_count",
                "blocking_issue_count",
                "evidence_ref_count"
              ],
              "properties": {
                "status": {
                  "type": "string",
                  "enum": [
                    "pass",
                    "warning",
                    "blocking"
                  ]
                },
                "check_count": {
                  "type": "integer",
                  "minimum": 0
                },
                "pass_count": {
                  "type": "integer",
                  "minimum": 0
                },
                "warning_count": {
                  "type": "integer",
                  "minimum": 0
                },
                "blocking_issue_count": {
                  "type": "integer",
                  "minimum": 0
                },
                "evidence_ref_count": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            "severity_counts": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "pass",
                "warning",
                "blocking"
              ],
              "properties": {
                "pass": {
                  "type": "integer",
                  "minimum": 0
                },
                "warning": {
                  "type": "integer",
                  "minimum": 0
                },
                "blocking": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            "checks": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/qc_contract_check"
              }
            },
            "blocking_issues": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/qc_contract_check"
              }
            },
            "warnings": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/qc_contract_check"
              }
            },
            "evidence_refs": {
              "type": "array",
              "items": {
                "type": "string"
