{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/video-editing-toolkit/capability-io.schema.json",
  "title": "Video Editing Toolkit Capability I/O Draft",
  "type": "object",
  "$defs": {
    "toolkit_run_input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "toolkit_id",
        "capability",
        "version",
        "input",
        "context"
      ],
      "properties": {
        "toolkit_id": {
          "const": "video-editing-toolkit"
        },
        "capability": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "input": {
          "type": "object"
        },
        "context": {
          "$ref": "#/$defs/run_context"
        }
      }
    },
    "toolkit_run_output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "toolkit_id",
        "capability",
        "version",
        "trace_id",
        "usage_metrics",
        "artifact_refs"
      ],
      "properties": {
        "toolkit_id": {
          "const": "video-editing-toolkit"
        },
        "capability": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "trace_id": {
          "type": "string"
        },
        "usage_metrics": {
          "$ref": "#/$defs/usage_metrics"
        },
        "artifact_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/artifact_ref"
          }
        },
        "error_code": {
          "type": "string"
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "media_artifact_input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_ref"
      ],
      "properties": {
        "artifact_ref": {
          "$ref": "#/$defs/artifact_ref"
        },
        "options": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "artifact_collection_input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_refs"
      ],
      "properties": {
        "artifact_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/artifact_ref"
          }
        },
        "options": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "project_input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_id"
      ],
      "properties": {
        "project_id": {
          "type": "string",
          "minLength": 1
        },
        "version_id": {
          "type": "string"
        },
        "options": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "project_version_compare_input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_id",
        "left_version_id",
        "right_version_id"
      ],
      "properties": {
        "project_id": {
          "type": "string",
          "minLength": 1
        },
        "left_version_id": {
          "type": "string",
          "minLength": 1
        },
        "right_version_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "timeline_patch_input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_id",
        "base_version_id",
        "timeline_patch",
        "change_reason",
        "requested_preview"
      ],
      "properties": {
        "project_id": {
          "type": "string",
          "minLength": 1
        },
        "base_version_id": {
          "type": "string",
          "minLength": 1
        },
        "timeline_patch": {
          "$ref": "#/$defs/timeline_patch"
        },
        "change_reason": {
          "type": "string",
          "minLength": 1
        },
        "requested_preview": {
          "type": "boolean"
        }
      }
    },
    "timeline_patch_output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_id",
        "new_version_id",
        "timeline_summary",
        "warnings",
        "artifact_refs"
      ],
      "properties": {
        "project_id": {
          "type": "string"
        },
        "new_version_id": {
          "type": "string"
        },
        "timeline_summary": {
          "type": "object",
          "additionalProperties": true
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "preview_artifact_ref": {
          "$ref": "#/$defs/artifact_ref"
        },
        "artifact_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/artifact_ref"
          }
        }
      }
    },
    "probe_media_output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metadata",
        "warnings"
      ],
      "properties": {
        "metadata": {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "duration_seconds",
            "streams"
          ],
          "properties": {
            "duration_seconds": {
              "type": "number",
              "minimum": 0
            },
            "streams": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": true
              }
            }
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "artifact_output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_refs",
        "warnings"
      ],
      "properties": {
        "artifact_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/artifact_ref"
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "project_output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_id",
        "version_id",
        "artifact_refs",
        "warnings"
      ],
      "properties": {
        "project_id": {
          "type": "string"
        },
        "version_id": {
          "type": "string"
        },
        "artifact_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/artifact_ref"
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "timeline_patch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operations"
      ],
      "properties": {
        "operations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/timeline_operation"
          }
        }
      }
    },
    "timeline_operation": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "op"
      ],
      "properties": {
        "op": {
          "type": "string",
          "enum": [
            "add_clip",
            "remove_clip",
            "split_clip",
            "move_clip",
            "set_in_out",
            "add_text",
            "add_audio",
            "set_transition",
            "set_effect"
          ]
        }
      }
    },
    "artifact_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "artifact_type",
        "owner_tenant_id",
        "created_by_run_id",
        "mime_type",
        "size_bytes",
        "checksum",
        "data_class",
        "retention_policy",
        "access_policy"
      ],
      "properties": {
        "artifact_id": {
          "type": "string",
          "minLength": 1
        },
        "artifact_type": {
          "type": "string",
          "minLength": 1
        },
        "owner_tenant_id": {
          "type": "string",
          "minLength": 1
        },
        "created_by_run_id": {
          "type": "string",
          "minLength": 1
        },
        "storage_uri": {
          "type": "string",
          "description": "Internal only. Do not expose to agents or upstream callers."
        },
        "mime_type": {
          "type": "string"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "checksum": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "algorithm",
            "value"
          ],
          "properties": {
            "algorithm": {
              "type": "string",
              "enum": [
                "sha256"
              ]
            },
            "value": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "data_class": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high",
            "restricted"
          ]
        },
        "retention_policy": {
          "type": "string"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "access_policy": {
          "type": "string"
        }
      }
    },
    "run_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tenant_id",
        "run_id",
        "tool_call_id"
      ],
      "properties": {
        "tenant_id": {
          "type": "string",
          "minLength": 1
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "tool_call_id": {
          "type": "string",
          "minLength": 1
        },
        "approval_context": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "usage_metrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "input_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "output_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "media_duration_seconds": {
          "type": "number",
          "minimum": 0
        },
        "frame_count": {
          "type": "integer",
          "minimum": 0
        },
        "render_seconds": {
          "type": "number",
          "minimum": 0
        },
        "transcript_minutes": {
          "type": "number",
          "minimum": 0
        },
        "worker_cpu_seconds": {
          "type": "number",
          "minimum": 0
        }
      }
    }
  }
}
