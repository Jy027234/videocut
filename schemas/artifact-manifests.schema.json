{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/video-editing-toolkit/artifact-manifests.schema.json",
  "title": "Video Editing Toolkit Artifact Manifests",
  "description": "Contracts for generated asset index, delivery manifest, package manifest, project timeline, and render config artifacts.",
  "oneOf": [
    {
      "$ref": "#/$defs/asset_index_manifest"
    },
    {
      "$ref": "#/$defs/delivery_manifest"
    },
    {
      "$ref": "#/$defs/package_manifest"
    },
    {
      "$ref": "#/$defs/project_timeline"
    },
    {
      "$ref": "#/$defs/render_config_manifest"
    },
    {
      "$ref": "#/$defs/voiceover_manifest"
    },
    {
      "$ref": "#/$defs/qc_report_manifest"
    },
    {
      "$ref": "#/$defs/remotion_template_validation_manifest"
    },
    {
      "$ref": "#/$defs/remotion_render_job_manifest"
    }
  ],
  "$defs": {
    "public_artifact_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "artifact_type",
        "mime_type",
        "size_bytes",
        "checksum",
        "data_class",
        "retention_policy"
      ],
      "properties": {
        "artifact_id": {
          "type": "string",
          "minLength": 1
        },
        "artifact_type": {
          "type": "string",
          "minLength": 1
        },
        "mime_type": {
          "type": "string",
          "minLength": 1
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "checksum": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "data_class": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high",
            "restricted",
            "sensitive"
          ]
        },
        "retention_policy": {
          "type": "string",
          "minLength": 1
        },
        "expires_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "access_policy": {
          "type": "object",
          "additionalProperties": true
        },
        "download_url": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "asset_index_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "project_id",
        "run_id",
        "asset_count",
        "assets"
      ],
      "properties": {
        "schema": {
          "const": "video_editing_toolkit.asset_index.v0"
        },
        "project_id": {
          "type": "string",
          "minLength": 1
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "asset_count": {
          "type": "integer",
          "minimum": 0
        },
        "assets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/asset_index_entry"
          }
        }
      }
    },
    "asset_index_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset_id",
        "input_index",
        "artifact_ref",
        "worker_input_resolved"
      ],
      "properties": {
        "asset_id": {
          "type": "string",
          "pattern": "^asset_[0-9]{4}$"
        },
        "input_index": {
          "type": "integer",
          "minimum": 0
        },
        "artifact_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/public_artifact_ref"
            },
            {
              "type": "null"
            }
          ]
        },
        "worker_input_resolved": {
          "type": "boolean"
        }
      }
    },
    "delivery_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "project_id",
        "version",
        "variant_count",
        "variants",
        "input_artifact_refs"
      ],
      "properties": {
        "schema": {
          "const": "video_editing_toolkit.delivery_manifest.v0"
        },
        "project_id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "variant_count": {
          "type": "integer",
          "minimum": 1
        },
        "variants": {
          "$ref": "#/$defs/variant_plan"
        },
        "input_artifact_refs": {
          "$ref": "#/$defs/public_artifact_refs"
        }
      }
    },
    "package_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "package_mode",
        "package_note",
        "project_id",
        "version",
        "variant_count",
        "variants",
        "input_artifact_refs"
      ],
      "properties": {
        "schema": {
          "const": "video_editing_toolkit.package_manifest.v0"
        },
        "package_mode": {
          "const": "manifest-only"
        },
        "package_note": {
          "type": "string",
          "minLength": 1
        },
        "project_id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "variant_count": {
          "type": "integer",
          "minimum": 1
        },
        "variants": {
          "$ref": "#/$defs/variant_plan"
        },
        "input_artifact_refs": {
          "$ref": "#/$defs/public_artifact_refs"
        }
      }
    },
    "project_timeline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "project_id",
        "version_id",
        "parent_version_id",
        "change_reason",
        "created_at",
        "created_by_run_id",
        "timeline_summary",
        "timeline"
      ],
      "properties": {
        "schema": {
          "const": "video_editing_toolkit.project_timeline.v0"
        },
        "project_id": {
          "type": "string",
          "minLength": 1
        },
        "version_id": {
          "type": "string",
          "minLength": 1
        },
        "parent_version_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "change_reason": {
          "type": "string",
          "minLength": 1
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "created_by_run_id": {
          "type": "string",
          "minLength": 1
        },
        "timeline_summary": {
          "$ref": "#/$defs/timeline_summary"
        },
        "timeline": {
          "$ref": "#/$defs/timeline_document"
        }
      }
    },
    "render_config_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "project_id",
        "version_id",
        "created_by_run_id",
        "render_target",
        "timeline_summary",
        "source_timeline_artifact_ref",
        "render_config"
      ],
      "properties": {
        "schema": {
          "const": "video_editing_toolkit.render_config.v0"
        },
        "project_id": {
          "type": "string",
          "minLength": 1
        },
        "version_id": {
          "type": "string",
          "minLength": 1
        },
        "created_by_run_id": {
          "type": "string",
          "minLength": 1
        },
        "render_target": {
          "const": "preview"
        },
        "timeline_summary": {
          "$ref": "#/$defs/timeline_summary"
        },
        "source_timeline_artifact_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/public_artifact_ref"
            },
            {
              "type": "null"
            }
          ]
        },
        "render_config": {
          "$ref": "#/$defs/render_config"
        }
      }
    },
    "timeline_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "duration_seconds",
        "video_tracks",
        "audio_tracks",
        "text_tracks"
      ],
      "properties": {
        "duration_seconds": {
          "type": "number",
          "minimum": 0
        },
        "video_tracks": {
          "type": "integer",
          "minimum": 0
        },
        "audio_tracks": {
          "type": "integer",
          "minimum": 0
        },
        "text_tracks": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "timeline_document": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "tracks",
        "transitions"
      ],
      "properties": {
        "tracks": {
          "type": "object",
          "additionalProperties": true
        },
        "transitions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    },
    "render_config": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "profile",
        "container",
        "video_codec",
        "audio_codec",
        "resolution",
        "include_audio"
      ],
      "properties": {
        "mode": {
          "const": "preview"
        },
        "profile": {
          "type": "string",
          "minLength": 1
        },
        "container": {
          "type": "string",
          "minLength": 1
        },
        "video_codec": {
          "type": "string",
          "minLength": 1
        },
        "audio_codec": {
          "type": "string",
          "minLength": 1
        },
        "resolution": {
          "type": "string",
          "minLength": 1
        },
        "include_audio": {
          "type": "boolean"
        },
        "max_duration_seconds": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "public_artifact_refs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/public_artifact_ref"
      }
    },
    "variant_plan": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/variant"
      }
    },
    "variant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "variant_id",
        "name",
        "delivery_target"
      ],
      "properties": {
        "variant_id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "delivery_target": {
          "type": "string",
          "minLength": 1
        },
        "format": {
          "$ref": "#/$defs/scalar_value"
        },
        "container": {
          "$ref": "#/$defs/scalar_value"
        },
        "resolution": {
          "$ref": "#/$defs/scalar_value"
        },
        "codec": {
          "$ref": "#/$defs/scalar_value"
        },
        "audio_codec": {
          "$ref": "#/$defs/scalar_value"
        },
        "bitrate": {
          "$ref": "#/$defs/scalar_value"
        }
      }
    },
    "scalar_value": {
      "type": [
        "string",
        "number",
        "integer",
        "boolean"
      ]
    },
    "voiceover_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "project_id",
        "run_id",
        "script_artifact_ref",
        "audio_artifact_ref",
        "voice_profile",
        "duration_seconds",
        "safety"
      ],
      "properties": {
        "schema": {
          "const": "video_editing_toolkit.voiceover.v1"
        },
        "project_id": {
          "type": "string",
          "minLength": 1
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "script_artifact_ref": {
          "$ref": "#/$defs/public_artifact_ref"
        },
        "audio_artifact_ref": {
          "$ref": "#/$defs/public_artifact_ref"
        },
        "voice_profile": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "voice_id"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "system_voice",
                "licensed_synthetic"
              ]
            },
            "voice_id": {
              "type": "string",
              "minLength": 1
            },
            "locale": {
              "type": "string"
            }
          }
        },
        "duration_seconds": {
          "type": "number",
          "minimum": 0
        },
        "safety": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "voice_cloning_used",
            "model_downloaded"
          ],
          "properties": {
            "voice_cloning_used": {
              "const": false
            },
            "model_downloaded": {
              "const": false
            }
          }
        }
      }
    },
    "qc_report_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "project_id",
        "run_id",
        "input_artifact_ref",
        "overall_status",
        "checks",
        "warnings"
      ],
      "properties": {
        "schema": {
          "const": "video_editing_toolkit.qc_report.v1"
        },
        "project_id": {
          "type": "string",
          "minLength": 1
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "input_artifact_ref": {
          "$ref": "#/$defs/public_artifact_ref"
        },
        "overall_status": {
          "type": "string",
          "enum": [
            "pass",
            "warn",
            "fail",
            "blocked"
          ]
        },
        "checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/qc_check_result"
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "qc_check_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "check",
        "status",
        "issue_count"
      ],
      "properties": {
        "check": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "pass",
            "warn",
            "fail",
            "blocked"
          ]
        },
        "issue_count": {
          "type": "integer",
          "minimum": 0
        },
        "summary": {
          "type": "string"
        }
      }
    },
    "remotion_template_validation_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "project_id",
        "run_id",
        "template_artifact_ref",
        "component_name",
        "valid",
        "diagnostics",
        "runtime"
      ],
      "properties": {
        "schema": {
          "const": "video_editing_toolkit.remotion_template_validation.v1"
        },
        "project_id": {
          "type": "string",
          "minLength": 1
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "template_artifact_ref": {
          "$ref": "#/$defs/public_artifact_ref"
        },
        "component_name": {
          "type": "string",
          "minLength": 1
        },
        "valid": {
          "type": "boolean"
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/template_diagnostic"
          }
        },
        "runtime": {
          "$ref": "#/$defs/p1_runtime_safety"
        }
      }
    },
    "remotion_render_job_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "project_id",
        "run_id",
        "job_id",
        "status",
        "template_artifact_ref",
        "props_artifact_ref",
        "render_settings",
        "runtime"
      ],
      "properties": {
        "schema": {
          "const": "video_editing_toolkit.remotion_render_job.v1"
        },
        "project_id": {
          "type": "string",
          "minLength": 1
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "job_id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "created",
            "blocked",
            "requires_runtime"
          ]
        },
        "template_artifact_ref": {
          "$ref": "#/$defs/public_artifact_ref"
        },
        "props_artifact_ref": {
          "$ref": "#/$defs/public_artifact_ref"
        },
        "render_settings": {
          "$ref": "#/$defs/remotion_render_settings"
        },
        "runtime": {
          "$ref": "#/$defs/p1_runtime_safety"
        }
      }
    },
    "template_diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "message"
      ],
      "properties": {
        "level": {
          "type": "string",
          "enum": [
            "info",
            "warning",
            "error"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "code": {
          "type": "string"
        }
      }
    },
    "remotion_render_settings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "container",
        "resolution",
        "fps",
        "duration_seconds"
      ],
      "properties": {
        "container": {
          "type": "string",
          "enum": [
            "mp4",
            "webm"
          ]
        },
        "resolution": {
          "type": "string",
          "minLength": 1
        },
        "fps": {
          "type": "number",
          "minimum": 1,
          "maximum": 120
        },
        "duration_seconds": {
          "type": "number",
          "minimum": 0
        },
        "codec": {
          "type": "string"
        },
        "audio_codec": {
          "type": "string"
        }
      }
    },
    "p1_runtime_safety": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chromium_ran",
        "model_downloaded"
      ],
      "properties": {
        "chromium_ran": {
          "const": false
        },
        "model_downloaded": {
          "const": false
        }
      }
    }
  }
}
