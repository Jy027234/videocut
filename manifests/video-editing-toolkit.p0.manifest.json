      },
      "data_sensitivity": "low",
      "approval_policy": "none",
      "artifact_policy": "metadata_only",
      "error_codes": [
        "MEDIA_UNREADABLE",
        "UNSUPPORTED_MEDIA_FORMAT",
        "ARTIFACT_ACCESS_DENIED"
