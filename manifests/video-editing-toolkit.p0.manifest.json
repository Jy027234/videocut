{
  "$schema": "../schemas/toolkit-manifest.schema.json",
  "toolkit_id": "video-editing-toolkit",
  "display_name": "Video Editing Toolkit",
  "category": "video_editing",
  "version": "0.1.0-p0",
  "status": "draft",
  "runtime_adapter": {
    "type": "local_worker",
    "target": "agentctl-compatible-adapter",
    "entrypoints": {
      "prepare": "prepare(input, context)",
      "run": "run(validated_input, context)",
      "cancel": "cancel(run_id)",
      "status": "status(run_id)",
      "cleanup": "cleanup(run_id, retention_policy)"
    }
  },
  "required_permissions": [
    "artifact:read",
    "artifact:write",
    "trace:write"
  ],
  "required_scopes": [
    "toolkit.video_editing.p0"
  ],
  "quota_metrics": [
    "input_bytes",
    "output_bytes",
    "media_duration_seconds",
    "frame_count",
    "render_seconds",
    "worker_cpu_seconds"
  ],
  "pricing_metrics": [
    "media_duration_seconds",
    "render_seconds",
    "transcript_minutes"
  ],
  "sandbox_policy": {
    "allow_raw_command": false,
    "input_source": "artifact_ref_only",
    "output_target": "artifact_ref_only",
    "return_local_paths": false,
    "network_access": "disabled_by_default"
  },
  "artifact_policy": {
    "return_contract": "artifact_ref",
    "storage_uri_visibility": "internal_only",
    "default_retention_days": 7,
    "preview_retention_days": 3,
    "final_retention_days": 30,
    "checksum_required": true,
    "access_policy": "tenant_and_explicit_grants"
  },
  "approval_policy": {
    "default": "none",
    "requires_confirmation_for": [
      "video.render.render_final",
      "video.delivery.package_artifacts",
      "video.delivery.create_delivery_manifest"
    ],
    "high_sensitivity_default": "disabled",
    "approval_context_fields": [
      "approval_id",
      "approved_by",
      "approved_at",
      "purpose",
      "retention_override"
    ]
  },
  "data_sensitivity": {
    "default": "medium",
    "levels": [
      "low",
      "medium",
      "high",
      "restricted"
    ],
    "p0_enabled_levels": [
      "low",
      "medium"
    ]
  },
  "input_schema": {
    "$ref": "../schemas/capability-io.schema.json#/$defs/toolkit_run_input"
  },
  "output_schema": {
    "$ref": "../schemas/capability-io.schema.json#/$defs/toolkit_run_output"
  },
  "capabilities": [
    {
